# ============ Site ============
# Public URL of the deployed site (used for SEO, sitemap, and emails).
NEXT_PUBLIC_SITE_URL=https://buildwithinnocent.com

# Google Search Console HTML-tag verification code (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ============ Supabase ============
# Project URL and the SERVICE ROLE key (server-side only — never expose
# this to the browser; it is only read in API routes).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public (browser) Supabase credentials — required for the client portal
# (magic-link sign-in on /client/login). The anon key is safe to expose;
# RLS policies protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============ Admin (/admin/analytics) ============
# HTTP Basic Auth credentials for the admin area. If unset, /admin/* is
# refused entirely.
ADMIN_USER=innocent
ADMIN_PASSWORD=choose-a-long-random-password

# ============ Retargeting pixels (all optional) ============
# Each pixel loads only when its ID is set.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# ============ Resend (confirmation emails) ============
RESEND_API_KEY=re_your_api_key
# Verified sender, e.g. "Build With Innocent <hello@buildwithinnocent.com>"
RESEND_FROM_EMAIL=

# ============ WhatsApp Cloud API (new-lead notifications) ============
# From Meta for Developers > WhatsApp > API Setup.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Innocent's number in international format without +, e.g. 233201234567
WHATSAPP_NOTIFY_NUMBER=
