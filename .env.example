# ============ Site ============
# Public URL of the deployed site (used for SEO, sitemap, and emails).
NEXT_PUBLIC_SITE_URL=https://buildwithinnocent.com

# Google Search Console HTML-tag verification code (optional).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# ============ Supabase ============
# Project URL and the SERVICE ROLE key (server-side only — never expose
# this to the browser; it is only read in API routes).
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Public (browser) Supabase credentials — required for the client portal
# (magic-link sign-in on /client/login). The anon key is safe to expose;
# RLS policies protect the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ============ Admin (/admin/analytics) ============
# HTTP Basic Auth credentials for the admin area. If unset, /admin/* is
# refused entirely.
ADMIN_USER=innocent
ADMIN_PASSWORD=choose-a-long-random-password

# ============ Retargeting pixels (all optional) ============
# Each pixel loads only when its ID is set.
NEXT_PUBLIC_FB_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_TAG_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# ============ Resend (confirmation emails) ============
RESEND_API_KEY=re_your_api_key
# Optional verified sender, e.g. "Build With Innocent <hello@offervaluewithinnocent.com>".
# Leave empty to keep the code default: Build With Innocent <onboarding@resend.dev>.
# Sending from offervaluewithinnocent.com works only after that domain is verified in Resend.
RESEND_FROM_EMAIL=

# ============ Public contact (click-to-chat) ============
# Optional override for the public click-to-chat number. Digits only, no + and
# no spaces. Leave empty to use the number built into lib/site.ts. Do not use
# 233201234567 — that example is ignored and the built-in number is used.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional. If empty, the site uses hello@offervaluewithinnocent.com.
# A value that looks like a placeholder (example.com, your-email) is ignored.
NEXT_PUBLIC_CONTACT_EMAIL=

# ============ Cloudflare Turnstile (optional spam check) ============
# Both must be set or the forms skip Turnstile entirely.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ============ WhatsApp Cloud API (new-lead notifications to the owner) ============
# From Meta for Developers > WhatsApp > API Setup.
# This is separate from NEXT_PUBLIC_WHATSAPP_NUMBER (the public click-to-chat number).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Owner's number in international digits, no +.
WHATSAPP_NOTIFY_NUMBER=
